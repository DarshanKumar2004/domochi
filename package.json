{
  "name": "domochi-donuts",
  "version": "0.1.0",
  "private": true,
  "description": "Domochi Donuts: a mochi donut food truck time-management game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
