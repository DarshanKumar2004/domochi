{
  "name": "domochi-donuts",
  "version": "1.0.0",
  "private": true,
  "description": "Domochi Donuts: a mochi donut food truck time-management game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "app-art": "node scripts/make-app-art.mjs && capacitor-assets generate --android --assetPath resources --iconBackgroundColor #fffaf0 --splashBackgroundColor #fffaf0",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:bundle": "npm run android:sync && cd android && gradlew bundleRelease",
    "android:apk": "npm run android:sync && cd android && gradlew assembleDebug",
    "store-art": "playwright test -c playwright.store.config.ts",
    "trailer-words": "node scripts/trailer-words.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
